NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
NOTICEBONDHU_DATA_DIR=./data

# Required for monitored notice extraction through Tavily.
TAVILY_API_KEY=
TAVILY_EXTRACT_DEPTH=advanced
NOTICE_FAILURE_RETRY_MINUTES=5

# Required for the admin dashboard. Use unique production values.
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Set true for web-only processes when a separate worker runs the scheduler.
DISABLE_SCHEDULER=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NoticeBondhu Alerts <alerts@example.com>
